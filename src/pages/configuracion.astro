---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryManager from "../components/CategoryManager.jsx";
import RulesEditor from "../components/RulesEditor.jsx";
import { createSupabaseServerClient } from "../lib/supabase.js";

// Ruta on-demand: requiere sesión.
export const prerender = false;

const supabase = createSupabaseServerClient(Astro);

const {
	data: { user },
} = await supabase.auth.getUser();

if (!user) {
	return Astro.redirect("/login");
}

const { data: categoryRows, error: catError } = await supabase
	.from("categories")
	.select("name, macro_type, target_amount");

if (catError) {
	throw new Error(`No se pudieron cargar las categorías: ${catError.message}`);
}

const categories = (categoryRows ?? []).map((row) => ({
	id: row.name,
	name: row.name,
	macro_type: row.macro_type ?? "",
	target_amount: Number(row.target_amount ?? 0),
}));

const { data: ruleRows, error: rulesError } = await supabase
	.from("distribution_rules")
	.select("category_id, percentage")
	.eq("user_id", user.id);

if (rulesError) {
	throw new Error(`No se pudieron cargar las reglas: ${rulesError.message}`);
}

const rules = ruleRows ?? [];
---

<BaseLayout title="Configuración · SalarySplitter">
	<main class="mx-auto w-full max-w-2xl px-4 py-8 sm:px-6 sm:py-12">
		<header class="mb-8 flex items-center justify-between gap-4">
			<div class="space-y-1">
				<h1 class="text-xl font-semibold tracking-tight sm:text-2xl">
					Configuración
				</h1>
				<p class="text-sm text-slate-400">
					Tus categorías y cómo se reparte cada ingreso.
				</p>
			</div>
			<a
				href="/dashboard"
				class="shrink-0 rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-400 transition-colors hover:text-slate-100"
			>
				← Dashboard
			</a>
		</header>

		<div class="space-y-10">
			<section class="space-y-3">
				<h2 class="text-xs font-medium uppercase tracking-[0.25em] text-slate-400">
					Categorías
				</h2>
				<CategoryManager client:load categories={categories} />
			</section>

			<section class="space-y-3">
				<h2 class="text-xs font-medium uppercase tracking-[0.25em] text-slate-400">
					Reparto por porcentaje
				</h2>
				<RulesEditor client:load categories={categories} rules={rules} />
			</section>
		</div>
	</main>
</BaseLayout>
