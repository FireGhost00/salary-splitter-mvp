---
import BaseLayout from "../layouts/BaseLayout.astro";
import BudgetConfigManager from "../components/BudgetConfigManager.jsx";
import MyCategories from "../components/MyCategories.jsx";
import { createSupabaseServerClient } from "../lib/supabase.js";
import { isSubcategory } from "../lib/budget.js";

// Ruta on-demand: requiere sesión.
export const prerender = false;

const supabase = createSupabaseServerClient(Astro);

const {
	data: { user },
} = await supabase.auth.getUser();

if (!user) {
	return Astro.redirect("/login");
}

const { data: cfgRow, error: cfgError } = await supabase
	.from("budget_config")
	.select("debt_enabled, debt_monthly_cents, provisions_enabled")
	.eq("user_id", user.id)
	.maybeSingle();

if (cfgError) {
	throw new Error(`No se pudo cargar budget_config: ${cfgError.message}`);
}

const { data: provRows, error: provError } = await supabase
	.from("provision_items")
	.select("id, label, annual_amount_cents")
	.eq("user_id", user.id)
	.order("created_at", { ascending: true });

if (provError) {
	throw new Error(`No se pudieron cargar los rubros: ${provError.message}`);
}

const budgetConfig = {
	debt_enabled: cfgRow?.debt_enabled ?? false,
	debt_monthly_cents: Number(cfgRow?.debt_monthly_cents ?? 0),
	provisions_enabled: cfgRow?.provisions_enabled ?? false,
};

const provisionItems = (provRows ?? []).map((row) => ({
	label: row.label,
	annual_amount_cents: Number(row.annual_amount_cents ?? 0),
}));

const { data: catRows } = await supabase
	.from("categories")
	.select("name, macro_type")
	.eq("user_id", user.id);

const subcategories = (catRows ?? [])
	.filter((row) => isSubcategory(row))
	.map((row) => ({ name: row.name, macro_type: row.macro_type }));
---

<BaseLayout title="Configuración · SalarySplitter">
	<main class="mx-auto w-full max-w-2xl px-4 py-8 sm:px-6 sm:py-12">
		<header class="mb-8 flex items-center justify-between gap-4">
			<div class="space-y-1">
				<h1 class="text-xl font-semibold tracking-tight sm:text-2xl">
					Configuración
				</h1>
				<p class="text-sm text-slate-400">
					Reparto fijo 50/30/20 · habilita Deuda y Provisiones.
				</p>
			</div>
			<a
				href="/dashboard"
				class="shrink-0 rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-400 transition-colors hover:text-slate-100"
			>
				← Dashboard
			</a>
		</header>

		<BudgetConfigManager
			client:load
			config={budgetConfig}
			provisionItems={provisionItems}
		/>

		<section class="mt-10 space-y-3">
			<h2 class="text-xs font-medium uppercase tracking-[0.25em] text-slate-400">
				Mis Categorías
			</h2>
			<MyCategories client:load categories={subcategories} />
		</section>
	</main>
</BaseLayout>
