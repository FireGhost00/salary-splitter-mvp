---
import BaseLayout from "../layouts/BaseLayout.astro";
import RulesEditor from "../components/RulesEditor.jsx";
import { createSupabaseServerClient } from "../lib/supabase.js";

// Ruta on-demand: requiere sesión.
export const prerender = false;

const supabase = createSupabaseServerClient(Astro);

const {
	data: { user },
} = await supabase.auth.getUser();

if (!user) {
	return Astro.redirect("/login");
}

const { data: categoryRows, error: catError } = await supabase
	.from("categories")
	.select("name");

if (catError) {
	throw new Error(`No se pudieron cargar las categorías: ${catError.message}`);
}

const categories = (categoryRows ?? []).map((row) => ({
	id: row.name,
	name: row.name,
}));

const { data: ruleRows, error: rulesError } = await supabase
	.from("distribution_rules")
	.select("category_id, percentage")
	.eq("user_id", user.id);

if (rulesError) {
	throw new Error(`No se pudieron cargar las reglas: ${rulesError.message}`);
}

const rules = ruleRows ?? [];
---

<BaseLayout title="Configuración · SalarySplitter">
	<main class="mx-auto w-full max-w-2xl px-4 py-8 sm:px-6 sm:py-12">
		<header class="mb-8 flex items-center justify-between gap-4">
			<div class="space-y-1">
				<h1 class="text-xl font-semibold tracking-tight sm:text-2xl">
					Reglas de distribución
				</h1>
				<p class="text-sm text-neutral-500">
					Qué porcentaje del salario va a cada categoría. Debe sumar 100%.
				</p>
			</div>
			<a
				href="/dashboard"
				class="shrink-0 rounded-lg border border-neutral-700 px-3 py-1.5 text-xs text-neutral-400 transition-colors hover:text-neutral-100"
			>
				← Dashboard
			</a>
		</header>

		<RulesEditor client:load categories={categories} rules={rules} />
	</main>
</BaseLayout>
