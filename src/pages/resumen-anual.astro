---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnnualSummary from "../components/AnnualSummary.jsx";
import IncomeVsExpensesChart from "../components/IncomeVsExpensesChart.jsx";
import ProvisionsGrowthChart from "../components/ProvisionsGrowthChart.jsx";
import ProvisionsDetailedTable from "../components/ProvisionsDetailedTable.jsx";
import { createSupabaseServerClient } from "../lib/supabase.js";
import { SYS_CAT } from "../lib/budget.js";

// Ruta on-demand: requiere sesión.
export const prerender = false;

const supabase = createSupabaseServerClient(Astro);

const {
	data: { user },
} = await supabase.auth.getUser();

if (!user) {
	return Astro.redirect("/login");
}

const year = new Date().getFullYear();
const yearStart = `${year}-01-01`;
const yearEnd = `${year}-12-31`;

// Todas las transacciones del año en curso (UNA sola consulta: alimenta las
// tarjetas Y la gráfica, así no divergen).
const { data: txRows, error: txError } = await supabase
	.from("transactions")
	.select("category_id, amount_cents, effective_date")
	.eq("user_id", user.id)
	.gte("effective_date", yearStart)
	.lte("effective_date", yearEnd);

if (txError) {
	throw new Error(
		`No se pudieron cargar las transacciones: ${txError.message}`,
	);
}

// macro_type + id por categoría, para clasificar las salidas.
const { data: catRows, error: catError } = await supabase
	.from("categories")
	.select("id, name, macro_type")
	.eq("user_id", user.id);

if (catError) {
	throw new Error(`No se pudieron cargar las categorías: ${catError.message}`);
}

const macroByName = new Map(
	(catRows ?? []).map((c) => [c.name, c.macro_type]),
);

// Un movimiento pertenece a un macro_type si su category_id coincide por NOMBRE,
// por UUID, o por el nombre canónico del sistema (robusto ante seeds mixtos).
function macroKeySet(macro, canonicalName) {
	const set = new Set([canonicalName]);
	for (const c of catRows ?? []) {
		if (c.macro_type === macro) {
			set.add(c.name);
			if (c.id != null) set.add(String(c.id));
		}
		if (c.name === canonicalName && c.id != null) set.add(String(c.id));
	}
	return set;
}
const provisionKeys = macroKeySet("provision", SYS_CAT.provision);
const debtKeys = macroKeySet("deuda", SYS_CAT.deuda);
const isProvisionTx = (cid) => provisionKeys.has(String(cid));
const isDebtTx = (cid) => debtKeys.has(String(cid));

// --- PASO 3: curva acumulada de Provisiones (sinking funds) ------------
// Neto mensual (aportes positivos + gastos negativos) de las categorías
// 'provision', arrastrando el saldo acumulado del mes anterior.
const MESES_CORTOS = [
	"Ene", "Feb", "Mar", "Abr", "May", "Jun",
	"Jul", "Ago", "Sep", "Oct", "Nov", "Dic",
];

const monthlyProvisionNet = Array(12).fill(0);
for (const tx of txRows ?? []) {
	if (!isProvisionTx(tx.category_id)) continue;
	// effective_date: 'YYYY-MM-DD' o ISO; los caracteres 6-7 son el mes.
	const m = Number(String(tx.effective_date).slice(5, 7)) - 1;
	if (m >= 0 && m < 12) {
		monthlyProvisionNet[m] += Number(tx.amount_cents ?? 0);
	}
}

let provisionRunning = 0;
const provisionsGrowth = monthlyProvisionNet.map((net, i) => {
	provisionRunning += net;
	return { month: MESES_CORTOS[i], balanceCents: provisionRunning };
});

// --- PASO 1: Ingresos vs Salidas por mes (YTD) ------------------------
// ingresos = suma de todo lo positivo; salidas = |suma de todo lo negativo|
// (gastos + pagos de deuda + provisiones, sin distinguir).
const incomeVsExpenses = MESES_CORTOS.map((month) => ({
	month,
	ingresos: 0,
	salidas: 0,
}));
for (const tx of txRows ?? []) {
	const m = Number(String(tx.effective_date).slice(5, 7)) - 1;
	if (m < 0 || m > 11) continue;
	const cents = Number(tx.amount_cents ?? 0);
	if (cents > 0) incomeVsExpenses[m].ingresos += cents;
	else incomeVsExpenses[m].salidas += Math.abs(cents);
}

// --- PASO 2: detalle por rubro de provisión (todo el historial) -------
const { data: provItemRows } = await supabase
	.from("provision_items")
	.select("id, label, annual_amount_cents")
	.eq("user_id", user.id);

const provItemAgg = new Map(); // id -> { saved, used }
if ((provItemRows ?? []).length > 0) {
	const { data: provItemTx } = await supabase
		.from("transactions")
		.select("provision_item_id, amount_cents")
		.eq("user_id", user.id)
		.not("provision_item_id", "is", null);
	for (const tx of provItemTx ?? []) {
		const e = provItemAgg.get(tx.provision_item_id) ?? { saved: 0, used: 0 };
		const c = Number(tx.amount_cents ?? 0);
		if (c > 0) e.saved += c;
		else e.used += Math.abs(c);
		provItemAgg.set(tx.provision_item_id, e);
	}
}

const provisionsDetailed = (provItemRows ?? []).map((it) => {
	const agg = provItemAgg.get(it.id) ?? { saved: 0, used: 0 };
	const annual = Number(it.annual_amount_cents ?? 0);
	return {
		label: it.label,
		annualCents: annual,
		monthlyCents: Math.round(annual / 12),
		savedCents: agg.saved, // ahorro_provisionado
		usedCents: agg.used, // cantidad_usada
		remainingCents: agg.saved - agg.used, // saldo / por usar
	};
});

let ingresosTotales = 0;
let totalDeudasPagadas = 0;
let totalProvisionado = 0;
let totalGastos = 0;

for (const tx of txRows ?? []) {
	const cents = Number(tx.amount_cents ?? 0);
	if (cents > 0) {
		ingresosTotales += cents;
		continue;
	}
	const out = Math.abs(cents);
	if (isDebtTx(tx.category_id)) totalDeudasPagadas += out;
	else if (isProvisionTx(tx.category_id)) totalProvisionado += out;
	else totalGastos += out;
}

// Balance neto = Ingresos − todas las salidas (= suma de todos los amount_cents).
const balanceNeto =
	ingresosTotales - totalDeudasPagadas - totalProvisionado - totalGastos;
---

<BaseLayout title="Resumen Anual · SalarySplitter">
	<main class="mx-auto w-full max-w-2xl px-4 py-8 sm:px-6 sm:py-12">
		<header class="mb-8 flex items-center justify-between gap-4">
			<div class="space-y-1">
				<h1 class="text-xl font-semibold tracking-tight sm:text-2xl">
					Resumen {year}
				</h1>
				<p class="text-sm text-slate-400">
					Todo tu año en cuatro números.
				</p>
			</div>
			<a
				href="/dashboard"
				class="shrink-0 rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-400 transition-colors hover:text-slate-100"
			>
				← Dashboard
			</a>
		</header>

		<AnnualSummary
			client:load
			year={year}
			ingresosTotales={ingresosTotales}
			totalDeudasPagadas={totalDeudasPagadas}
			totalProvisionado={totalProvisionado}
			totalGastos={totalGastos}
			balanceNeto={balanceNeto}
		/>

		<section class="mt-8 space-y-3">
			<h2 class="text-xs font-medium uppercase tracking-[0.25em] text-slate-400">
				Ingresos vs. salidas
			</h2>
			<IncomeVsExpensesChart client:load data={incomeVsExpenses} />
		</section>

		<section class="mt-8 space-y-3">
			<h2 class="text-xs font-medium uppercase tracking-[0.25em] text-slate-400">
				Crecimiento de provisiones
			</h2>
			<ProvisionsGrowthChart client:load data={provisionsGrowth} />
		</section>

		<section class="mt-8 space-y-3">
			<h2 class="text-xs font-medium uppercase tracking-[0.25em] text-slate-400">
				Detalle de provisiones
			</h2>
			<ProvisionsDetailedTable client:load data={provisionsDetailed} />
		</section>
	</main>
</BaseLayout>
