---
import BaseLayout from "../layouts/BaseLayout.astro";
import { createSupabaseServerClient } from "../lib/supabase.js";

// Ruta on-demand: crea/actualiza el perfil del usuario activo.
export const prerender = false;

const supabase = createSupabaseServerClient(Astro);

const {
	data: { user },
} = await supabase.auth.getUser();

if (!user) {
	return Astro.redirect("/login");
}

let errorMessage: string | null = null;

if (Astro.request.method === "POST") {
	const form = await Astro.request.formData();
	const firstName = String(form.get("first_name") ?? "").trim();
	// base_salary es ahora opcional (referencia, no se usa para calcular saldos).
	const parsedSalary = Number.parseFloat(String(form.get("base_salary") ?? ""));
	const baseSalary =
		Number.isFinite(parsedSalary) && parsedSalary > 0 ? parsedSalary : 0;

	if (!firstName) {
		errorMessage = "El nombre es obligatorio.";
	} else {
		// upsert por PK (id): sirve tanto para el alta como para editar luego.
		const { error: profileError } = await supabase.from("profiles").upsert({
			id: user.id,
			first_name: firstName,
			base_salary: baseSalary,
		});

		if (profileError) {
			errorMessage = profileError.message;
		} else {
			// Categorías 100% dinámicas: el usuario las crea en /configuracion.
			// Ya no se siembran categorías por defecto.
			return Astro.redirect("/dashboard");
		}
	}
}

// Prefill si ya existe un perfil parcial.
const { data: profile } = await supabase
	.from("profiles")
	.select("first_name, base_salary")
	.eq("id", user.id)
	.maybeSingle();
---

<BaseLayout title="Configura tu perfil · SalarySplitter">
	<main
		class="mx-auto flex min-h-screen w-full max-w-sm flex-col justify-center px-6 py-16"
	>
		<header class="mb-8 space-y-1">
			<h1 class="text-xl font-semibold tracking-tight">Casi listo</h1>
			<p class="text-sm text-slate-400">
				Necesitamos tu nombre y tu salario base para calcular los sobres.
			</p>
		</header>

		<form method="POST" class="space-y-4">
			<label class="block space-y-1">
				<span class="text-xs uppercase tracking-wider text-slate-400">Nombre</span>
				<input
					type="text"
					name="first_name"
					required
					value={profile?.first_name ?? ""}
					autocomplete="given-name"
					class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100 placeholder-slate-500 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
				/>
			</label>

			<label class="block space-y-1">
				<span class="text-xs uppercase tracking-wider text-slate-400">
					Salario base <span class="normal-case text-slate-500">(opcional, solo referencia)</span>
				</span>
				<input
					type="number"
					name="base_salary"
					inputmode="decimal"
					step="0.01"
					min="0"
					placeholder="0.00"
					value={profile?.base_salary ?? ""}
					class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 font-mono text-sm text-slate-100 placeholder-slate-500 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
				/>
			</label>

			{errorMessage && <p class="text-xs text-rose-400">{errorMessage}</p>}

			<button
				type="submit"
				class="w-full rounded-lg bg-emerald-600 px-3 py-2 text-sm font-semibold text-white transition-colors hover:bg-emerald-500"
			>
				Guardar y continuar
			</button>
		</form>
	</main>
</BaseLayout>
