---
import BaseLayout from "../layouts/BaseLayout.astro";
import AccountForm from "../components/AccountForm.jsx";
import ProfileForm from "../components/ProfileForm.jsx";
import { createSupabaseServerClient } from "../lib/supabase.js";

// Ruta on-demand: requiere sesión.
export const prerender = false;

const supabase = createSupabaseServerClient(Astro);

const {
	data: { user },
} = await supabase.auth.getUser();

if (!user) {
	return Astro.redirect("/login");
}

const { data: profile } = await supabase
	.from("profiles")
	.select("first_name, base_salary")
	.eq("id", user.id)
	.maybeSingle();

// ¿El usuario puede cambiar su contraseña? Solo si tiene identidad de correo
// (los que entraron con Google no usan contraseña).
const providers =
	user.app_metadata?.providers ??
	(user.app_metadata?.provider ? [user.app_metadata.provider] : []);
const canChangePassword =
	providers.includes("email") ||
	(user.identities ?? []).some((i) => i.provider === "email");

// Nombre para mostrar: metadatos de Auth y, si no, el de `profiles`.
const displayName =
	user.user_metadata?.display_name ??
	user.user_metadata?.full_name ??
	profile?.first_name ??
	"";
---

<BaseLayout title="Perfil · SalarySplitter">
	<main class="mx-auto w-full max-w-md px-4 py-8 sm:px-6 sm:py-12">
		<header class="mb-8 flex items-center justify-between gap-4">
			<div class="space-y-1">
				<h1 class="text-xl font-semibold tracking-tight sm:text-2xl">Tu perfil</h1>
				<p class="text-sm text-slate-400">{user.email}</p>
			</div>
			<a
				href="/dashboard"
				class="shrink-0 rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-400 transition-colors hover:text-slate-100"
			>
				← Dashboard
			</a>
		</header>

		<div class="space-y-8">
			<AccountForm
				client:load
				email={user.email}
				displayName={displayName}
				canChangePassword={canChangePassword}
			/>

			<section class="space-y-3">
				<h2
					class="text-xs font-medium uppercase tracking-[0.25em] text-slate-400"
				>
					Presupuesto
				</h2>
				<ProfileForm client:load profile={profile ?? {}} />
			</section>
		</div>
	</main>
</BaseLayout>
