---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProfileForm from "../components/ProfileForm.jsx";
import { createSupabaseServerClient } from "../lib/supabase.js";

// Ruta on-demand: requiere sesión.
export const prerender = false;

const supabase = createSupabaseServerClient(Astro);

const {
	data: { user },
} = await supabase.auth.getUser();

if (!user) {
	return Astro.redirect("/login");
}

const { data: profile } = await supabase
	.from("profiles")
	.select("first_name, base_salary")
	.eq("id", user.id)
	.maybeSingle();
---

<BaseLayout title="Perfil · SalarySplitter">
	<main class="mx-auto w-full max-w-md px-4 py-8 sm:px-6 sm:py-12">
		<header class="mb-8 flex items-center justify-between gap-4">
			<div class="space-y-1">
				<h1 class="text-xl font-semibold tracking-tight sm:text-2xl">Tu perfil</h1>
				<p class="text-sm text-slate-400">{user.email}</p>
			</div>
			<a
				href="/dashboard"
				class="shrink-0 rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-400 transition-colors hover:text-slate-100"
			>
				← Dashboard
			</a>
		</header>

		<ProfileForm client:load profile={profile ?? {}} />
	</main>
</BaseLayout>
