---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroBalance from "../components/dashboard/HeroBalance.astro";
import IncomeProgress from "../components/dashboard/IncomeProgress.astro";
import QuincenaTracker from "../components/dashboard/QuincenaTracker.astro";
import EnvelopeCard from "../components/dashboard/EnvelopeCard.astro";
import TransactionList from "../components/TransactionList.jsx";
import QuickExpenseModal from "../components/dashboard/QuickExpenseModal.jsx";
import IncomeModal from "../components/dashboard/IncomeModal.jsx";
import DashboardCharts from "../components/DashboardCharts.jsx";
import DebtTracker from "../components/DebtTracker.jsx";
import { createSupabaseServerClient } from "../lib/supabase.js";
import {
	isSubcategory,
	monthlyProvisionCents,
	parentMasterOf,
	splitIncome,
} from "../lib/budget.js";
import { formatCents } from "../lib/money";

// Ruta on-demand: necesita la sesión del usuario en cada request.
export const prerender = false;

const supabase = createSupabaseServerClient(Astro);

// Sesión (Supabase Auth). Sin usuario -> al login.
const {
	data: { user },
} = await supabase.auth.getUser();

if (!user) {
	return Astro.redirect("/login");
}

// PASO 3: cuenta sin sembrar (0 categorías) -> onboarding.
const { count: categoryCount } = await supabase
	.from("categories")
	.select("name", { count: "exact", head: true })
	.eq("user_id", user.id);

if ((categoryCount ?? 0) === 0) {
	return Astro.redirect("/onboarding");
}

// Onboarding obligatorio: basta con que exista la fila de perfil (nombre).
// Ya no se usa base_salary: el saldo sube solo con ingresos manuales.
const { data: profile, error: profileError } = await supabase
	.from("profiles")
	.select("first_name, ideal_monthly_income_cents")
	.eq("id", user.id)
	.maybeSingle();

if (profileError) {
	throw new Error(`No se pudo cargar profiles: ${profileError.message}`);
}

if (!profile) {
	return Astro.redirect("/onboarding");
}

// US-15: presupuesto mensual. Mes y año actuales (o vía URL para un futuro
// selector de mes). getMonth() es 0-indexado -> +1 para el rango 1..12.
const nowRef = new Date();
const year =
	Number.parseInt(Astro.url.searchParams.get("year") ?? "", 10) ||
	nowRef.getFullYear();
const month =
	Number.parseInt(Astro.url.searchParams.get("month") ?? "", 10) ||
	nowRef.getMonth() + 1;

// Vista mensual, ya filtrada por usuario vía RLS, acotada al mes en curso.
const { data, error } = await supabase
	.from("monthly_balances")
	.select("*")
	.eq("year", year)
	.eq("month", month);

if (error) {
	throw new Error(`No se pudo cargar monthly_balances: ${error.message}`);
}

const balances = data ?? [];

// monthly_balances: { category_id (text = nombre de la categoría), month, year,
// balance (bigint, centavos) }. Saldo total del mes = suma de todos los balance
// (CONVENCIONES.md §2). Number() por si el bigint llega como string.
const totalBalanceCents = balances.reduce(
	(total, row) => total + Number(row.balance ?? 0),
	0,
);

// Saldo diferido: ingresos con effective_date POSTERIOR al último día del mes
// mostrado (los que se marcaron "Aplicar al próximo mes"). Es una consulta
// APARTE y su valor NO entra en totalBalanceCents (no afecta la liquidez actual).
const pad2 = (n: number) => String(n).padStart(2, "0");
const lastDayOfMonth = new Date(year, month, 0); // month 1..12 -> día 0 del mes+1
const monthEndISO = `${lastDayOfMonth.getFullYear()}-${pad2(lastDayOfMonth.getMonth() + 1)}-${pad2(lastDayOfMonth.getDate())}`;
const monthStartISO = `${year}-${pad2(month)}-01`;

const { data: deferredRows, error: deferredError } = await supabase
	.from("transactions")
	.select("amount_cents")
	.eq("user_id", user.id)
	.gt("amount_cents", 0)
	.gt("effective_date", monthEndISO);

if (deferredError) {
	console.warn("No se pudo calcular saldoDiferido:", deferredError.message);
}

const saldoDiferido = (deferredRows ?? []).reduce(
	(total, row) => total + Number(row.amount_cents ?? 0),
	0,
);

// categories: PK compuesta (user_id, name); no existe columna id -> `name` es el
// identificador. `type` para la etiqueta del sobre; `macro_type` para agrupar
// el <select> del modal de gastos.
const { data: categoryRows, error: categoriesError } = await supabase
	.from("categories")
	.select("name, type, macro_type, target_amount");

if (categoriesError) {
	console.warn("No se pudo cargar categories:", categoriesError.message);
}

// Saldo del mes por categoría (de monthly_balances).
const monthlyByName = new Map(
	balances.map((row) => [row.category_id, Number(row.balance ?? 0)]),
);

// Sinking funds: los sobres 'provision' arrastran saldo. Su "Saldo Disponible
// Total" = SUM de TODAS sus transacciones históricas, no solo las del mes.
const provisionNames = (categoryRows ?? [])
	.filter((row) => row.macro_type === "provision")
	.map((row) => row.name);

const provisionLifetime: Record<string, number> = {};
if (provisionNames.length > 0) {
	const { data: provTxRows, error: provTxError } = await supabase
		.from("transactions")
		.select("category_id, amount_cents")
		.eq("user_id", user.id)
		.in("category_id", provisionNames);

	if (provTxError) {
		console.warn(
			"No se pudo calcular el saldo acumulado de provisiones:",
			provTxError.message,
		);
	}
	for (const row of provTxRows ?? []) {
		provisionLifetime[row.category_id] =
			(provisionLifetime[row.category_id] ?? 0) + Number(row.amount_cents ?? 0);
	}
}

/** Saldo disponible de una categoría: acumulado si es provisión, mensual si no. */
function availableCentsFor(name: string, macroType: string | null): number {
	return macroType === "provision"
		? (provisionLifetime[name] ?? 0)
		: (monthlyByName.get(name) ?? 0);
}

// Subcategorías (Alquiler, Restaurantes, …): NO son opciones planas del modal,
// se agrupan bajo su master. El gasto contra ellas descuenta del master.
const subcategoriesForModal = (categoryRows ?? [])
	.filter((row) => isSubcategory(row))
	.map((row) => ({
		name: row.name,
		parentMaster: parentMasterOf(row.macro_type),
	}));

// Lista para el <select> del modal: masters + Deuda + Provisiones (sin subcats),
// con el saldo disponible por categoría.
const categories = (categoryRows ?? [])
	.filter((row) => !isSubcategory(row))
	.map((row) => ({
		id: row.name,
		name: row.name,
		macro_type: row.macro_type,
		availableCents: availableCentsFor(row.name, row.macro_type),
	}));

// nombre -> type: la vista monthly_balances no trae el type de la categoría.
const categoryTypeByName = new Map(
	(categoryRows ?? []).map((row) => [row.name, row.type]),
);

// Sobres a mostrar: los que tuvieron movimiento este mes + SIEMPRE las
// provisiones (aunque el mes no tengan actividad, para verlas crecer).
const envelopes = (categoryRows ?? [])
	.map((row) => {
		const isProvision = row.macro_type === "provision";
		return {
			name: row.name,
			type: row.type ?? "",
			isProvision,
			balanceInCents: availableCentsFor(row.name, row.macro_type),
			hasMonthlyRow: monthlyByName.has(row.name),
		};
	})
	.filter((e) => e.isProvision || e.hasMonthlyRow);

// Categorías dinámicas para el panel (nombre, macro_type, target_amount).
const dashCategories = (categoryRows ?? [])
	.filter((row) => !isSubcategory(row))
	.map((row) => ({
		name: row.name,
		macro_type: row.macro_type ?? "estandar",
		target_amount: Number(row.target_amount ?? 0),
	}));

// Transacciones del mes en curso (para el panel de categorías).
const { data: monthTransactions, error: monthTxError } = await supabase
	.from("transactions")
	.select("category_id, amount_cents, transaction_type")
	.eq("user_id", user.id)
	.gte("effective_date", monthStartISO)
	.lte("effective_date", monthEndISO);

if (monthTxError) {
	console.warn(
		"No se pudieron cargar las transacciones del mes:",
		monthTxError.message,
	);
}

const monthTx = monthTransactions ?? [];

// --- Alerta de déficit (modelo 50/30/20) -------------------------------
// Costos fijos mensuales (deuda + provisión) contra el 50 % del ingreso del mes.
const { data: budgetCfg } = await supabase
	.from("budget_config")
	.select("debt_enabled, debt_monthly_cents, provisions_enabled")
	.eq("user_id", user.id)
	.maybeSingle();

const { data: provisionRows } = await supabase
	.from("provision_items")
	.select("id, label, annual_amount_cents")
	.eq("user_id", user.id);

const debtMonthlyCents =
	budgetCfg?.debt_enabled === true ? Number(budgetCfg.debt_monthly_cents) || 0 : 0;
const provisionMonthlyCents =
	budgetCfg?.provisions_enabled === true
		? monthlyProvisionCents(provisionRows ?? [])
		: 0;

// PASO 1 (rubros): saldo disponible acumulado por cada rubro de provisión.
const provItemIds = (provisionRows ?? []).map((r) => r.id);
const provItemBalance = {};
if (provItemIds.length > 0) {
	const { data: provItemTx } = await supabase
		.from("transactions")
		.select("provision_item_id, amount_cents")
		.eq("user_id", user.id)
		.in("provision_item_id", provItemIds);
	for (const row of provItemTx ?? []) {
		provItemBalance[row.provision_item_id] =
			(provItemBalance[row.provision_item_id] ?? 0) +
			Number(row.amount_cents ?? 0);
	}
}
const provisionItemsForModal = (provisionRows ?? []).map((r) => ({
	id: r.id,
	label: r.label,
	availableCents: provItemBalance[r.id] ?? 0,
}));
const fixedMonthlyCents = debtMonthlyCents + provisionMonthlyCents;

// PASO 1: lo YA cubierto este mes = ingresos destinados a Deuda / Provisiones.
// El remanente por cubrir es lo que el modal debe evaluar contra el 50 %.
const alreadyPaidFixedCents = monthTx.reduce((total, row) => {
	const goesToFixed =
		row.category_id === "Deuda" || row.category_id === "Provisiones";
	return row.transaction_type === "ingreso" && goesToFixed
		? total + Math.max(0, Number(row.amount_cents ?? 0))
		: total;
}, 0);
const remanenteFijoPorCubrir = Math.max(
	0,
	fixedMonthlyCents - alreadyPaidFixedCents,
);

// Ingreso del mes = suma de las transacciones de tipo 'ingreso' del mes.
const ingresoTotalMes = monthTx.reduce(
	(total, row) =>
		row.transaction_type === "ingreso"
			? total + Math.max(0, Number(row.amount_cents ?? 0))
			: total,
	0,
);
const monthIncomeCents = ingresoTotalMes;

// Meta de ingreso mensual del "Mes Ideal" (profiles.ideal_monthly_income_cents).
const idealMonthlyIncomeCents = Number(profile?.ideal_monthly_income_cents ?? 0);

const deficitInfo = splitIncome(monthIncomeCents, {
	debtCents: debtMonthlyCents,
	provisionCents: provisionMonthlyCents,
});
const showDeficitBanner = monthIncomeCents > 0 && deficitInfo.deficit;

// Historial de movimientos fragmentados (lista bajo las gráficas).
// `transactions.category_id` ES el nombre de la categoría (FK compuesta
// (user_id, category_id) -> categories(user_id, name)); no hace falta embed.
const { data: feedRows, error: feedError } = await supabase
	.from("transactions")
	.select(
		"id, category_id, description, label, amount_cents, transaction_type, created_at, effective_date",
	)
	.eq("user_id", user.id)
	.order("created_at", { ascending: false })
	.limit(200);

if (feedError) {
	console.warn("No se pudo cargar el historial:", feedError.message);
}

const movimientos = feedRows ?? [];

// --- DebtTracker: avance de pago por deuda -------------------------------
const { data: debtCats, error: debtCatError } = await supabase
	.from("categories")
	.select("name, target_amount")
	.eq("user_id", user.id)
	.eq("macro_type", "deuda");

if (debtCatError) {
	console.warn("No se pudieron cargar las deudas:", debtCatError.message);
}

const debtNames = (debtCats ?? []).map((c) => c.name);
const debtPaid: Record<string, number> = {};

if (debtNames.length > 0) {
	const { data: payRows, error: payError } = await supabase
		.from("transactions")
		.select("category_id, amount_cents")
		.eq("user_id", user.id)
		.in("category_id", debtNames)
		.gt("amount_cents", 0);

	if (payError) {
		console.warn("No se pudieron cargar los abonos:", payError.message);
	}
	for (const row of payRows ?? []) {
		debtPaid[row.category_id] =
			(debtPaid[row.category_id] ?? 0) + Number(row.amount_cents);
	}
}

const deudas = (debtCats ?? []).map((c) => {
	const targetCents = Number(c.target_amount ?? 0);
	const paidCents = debtPaid[c.name] ?? 0;
	const percent =
		targetCents > 0
			? Math.min(100, Math.round((paidCents / targetCents) * 100))
			: 0;
	return { name: c.name, paidCents, targetCents, percent };
});
---

<BaseLayout title="Dashboard · SalarySplitter">
	<div class="min-h-screen bg-slate-900 text-slate-100">
		<main class="mx-auto w-full max-w-5xl px-4 py-8 pb-32 sm:px-6 sm:py-12 sm:pb-32">
		<header class="mb-8 flex items-start justify-between gap-4">
			<div class="space-y-1">
				<h1 class="text-xl font-semibold tracking-tight text-slate-100 sm:text-2xl">
					Dashboard
				</h1>
				<p class="text-sm text-slate-400">{user.email}</p>
			</div>
			<form method="POST" action="/api/auth/signout">
				<button
					type="submit"
					class="rounded-lg border border-slate-700 bg-slate-800 px-3 py-1.5 text-xs text-slate-400 transition-colors hover:bg-slate-700 hover:text-slate-100"
				>
					Salir
				</button>
			</form>
		</header>

		{
			showDeficitBanner && (
				<div class="mb-6 rounded-xl border border-rose-500/40 bg-rose-500/10 px-4 py-3 text-sm text-rose-300">
					<p class="font-semibold">⚠️ Presupuesto en déficit</p>
					<p class="mt-1 text-xs">
						Tus costos fijos ({formatCents(debtMonthlyCents + provisionMonthlyCents)} —
						deuda {formatCents(debtMonthlyCents)} + provisión{" "}
						{formatCents(provisionMonthlyCents)}) superan el 50 % del ingreso de
						este mes ({formatCents(deficitInfo.shares.necesidad)}). Te faltan{" "}
						{formatCents(deficitInfo.over_cents)}. Ajusta la Deuda o las
						Provisiones en <a class="underline" href="/configuracion">Configuración</a>.
					</p>
				</div>
			)
		}

		<div class="space-y-8">
			<DebtTracker client:load debts={deudas} />

			<div class="space-y-3">
				<div class="flex items-center justify-between">
					<h2 class="text-xs font-medium uppercase tracking-[0.25em] text-slate-400">
						Saldo total
					</h2>
					<IncomeModal
						client:load
						pendingFixedCents={remanenteFijoPorCubrir}
						alreadyPaidFixedCents={alreadyPaidFixedCents}
					/>
				</div>
				<HeroBalance
					amountInCents={totalBalanceCents}
					saldoDiferido={saldoDiferido}
					userId={user.id}
				/>
				<IncomeProgress
					realCents={ingresoTotalMes}
					expectedCents={idealMonthlyIncomeCents}
				/>
			</div>

			<section class="space-y-3">
				<h2 class="text-xs font-medium uppercase tracking-[0.25em] text-slate-400">
					Categorías del mes
				</h2>
				<DashboardCharts
					client:load
					categories={dashCategories}
					transactions={monthTx}
				/>
			</section>

			<section class="space-y-3">
				<h2 class="text-xs font-medium uppercase tracking-[0.25em] text-slate-400">
					Quincena
				</h2>
				<QuincenaTracker />
			</section>

			<section class="space-y-3">
				<h2 class="text-xs font-medium uppercase tracking-[0.25em] text-slate-400">
					Sobres
				</h2>
				{/* Mobile-first: 1 columna en móvil, CSS Grid de 3 columnas en escritorio. */}
				<div class="grid grid-cols-1 gap-4 md:grid-cols-3">
					{
						envelopes.map((envelope) => (
							<EnvelopeCard
								title={envelope.name}
								type={envelope.type}
								balanceInCents={envelope.balanceInCents}
								accumulated={envelope.isProvision}
							/>
						))
					}
				</div>
			</section>

			<section class="space-y-3">
				<h2 class="text-xs font-medium uppercase tracking-[0.25em] text-slate-400">
					Movimientos
				</h2>
				<TransactionList client:load transactions={movimientos} />
			</section>
		</div>

		<QuickExpenseModal
			categories={categories}
			provisionItems={provisionItemsForModal}
			subcategories={subcategoriesForModal}
			client:load
		/>
		</main>
	</div>
</BaseLayout>
