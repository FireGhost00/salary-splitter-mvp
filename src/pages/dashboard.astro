---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroBalance from "../components/dashboard/HeroBalance.astro";
import QuincenaTracker from "../components/dashboard/QuincenaTracker.astro";
import EnvelopeCard from "../components/dashboard/EnvelopeCard.astro";
import TransactionList from "../components/dashboard/TransactionList.astro";
import QuickExpenseModal from "../components/dashboard/QuickExpenseModal.jsx";
import IncomeModal from "../components/dashboard/IncomeModal.jsx";
import { createSupabaseServerClient } from "../lib/supabase.js";

// Ruta on-demand: necesita la sesión del usuario en cada request.
export const prerender = false;

const supabase = createSupabaseServerClient(Astro);

// Sesión (Supabase Auth). Sin usuario -> al login.
const {
	data: { user },
} = await supabase.auth.getUser();

if (!user) {
	return Astro.redirect("/login");
}

// Onboarding obligatorio: sin fila en `profiles` o con base_salary nulo/cero
// -> a /onboarding. base_salary es DECIMAL; se convierte a centavos enteros
// (CONVENCIONES.md §2) antes de pasarlo a los componentes.
const { data: profile, error: profileError } = await supabase
	.from("profiles")
	.select("first_name, base_salary")
	.eq("id", user.id)
	.maybeSingle();

if (profileError) {
	throw new Error(`No se pudo cargar profiles: ${profileError.message}`);
}

const baseSalary = Number(profile?.base_salary ?? 0);

if (!profile || !baseSalary) {
	return Astro.redirect("/onboarding");
}

const baseSalaryCents = Math.round(baseSalary * 100);

// US-15: presupuesto mensual. Mes y año actuales (o vía URL para un futuro
// selector de mes). getMonth() es 0-indexado -> +1 para el rango 1..12.
const nowRef = new Date();
const year =
	Number.parseInt(Astro.url.searchParams.get("year") ?? "", 10) ||
	nowRef.getFullYear();
const month =
	Number.parseInt(Astro.url.searchParams.get("month") ?? "", 10) ||
	nowRef.getMonth() + 1;

// Vista mensual, ya filtrada por usuario vía RLS, acotada al mes en curso.
const { data, error } = await supabase
	.from("monthly_balances")
	.select("*")
	.eq("year", year)
	.eq("month", month);

if (error) {
	throw new Error(`No se pudo cargar monthly_balances: ${error.message}`);
}

const balances = data ?? [];

// monthly_balances: { category_id (text = nombre de la categoría), month, year,
// balance (bigint, centavos) }. Saldo total del mes = suma de todos los balance
// (CONVENCIONES.md §2). Number() por si el bigint llega como string.
const totalBalanceCents = balances.reduce(
	(total, row) => total + Number(row.balance ?? 0),
	0,
);

// categories: PK compuesta (user_id, name); no existe columna id -> `name` es el
// identificador. `type` se usa para la etiqueta de cada sobre.
const { data: categoryRows, error: categoriesError } = await supabase
	.from("categories")
	.select("name, type");

if (categoriesError) {
	console.warn("No se pudo cargar categories:", categoriesError.message);
}

// Lista para el <select> del modal (forma { id, name }).
const categories = (categoryRows ?? []).map((row) => ({
	id: row.name,
	name: row.name,
}));

// nombre -> type: la vista monthly_balances no trae el type de la categoría.
const categoryTypeByName = new Map(
	(categoryRows ?? []).map((row) => [row.name, row.type]),
);
---

<BaseLayout title="Dashboard · AUTO-SALDO">
	<main class="mx-auto w-full max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
		<header class="mb-8 flex items-start justify-between gap-4">
			<div class="space-y-1">
				<h1 class="text-xl font-semibold tracking-tight sm:text-2xl">Dashboard</h1>
				<p class="text-sm text-neutral-500">{user.email}</p>
			</div>
			<form method="POST" action="/api/auth/signout">
				<button
					type="submit"
					class="rounded-lg border border-neutral-700 px-3 py-1.5 text-xs text-neutral-400 transition-colors hover:text-neutral-100"
				>
					Salir
				</button>
			</form>
		</header>

		<div class="space-y-8">
			<div class="space-y-3">
				<div class="flex items-center justify-between">
					<h2 class="text-xs font-medium uppercase tracking-[0.25em] text-neutral-500">
						Saldo total
					</h2>
					<IncomeModal client:load />
				</div>
				<HeroBalance
					amountInCents={totalBalanceCents}
					baseSalaryInCents={baseSalaryCents}
				/>
			</div>

			<section class="space-y-3">
				<h2 class="text-xs font-medium uppercase tracking-[0.25em] text-neutral-500">
					Quincena
				</h2>
				<QuincenaTracker baseSalaryInCents={baseSalaryCents} />
			</section>

			<section class="space-y-3">
				<h2 class="text-xs font-medium uppercase tracking-[0.25em] text-neutral-500">
					Sobres
				</h2>
				{/* Mobile-first: 1 columna en móvil, CSS Grid de 3 columnas en escritorio. */}
				<div class="grid grid-cols-1 gap-4 md:grid-cols-3">
					{
						balances.map((row) => (
							<EnvelopeCard
								title={row.category_id}
								type={categoryTypeByName.get(row.category_id) ?? ""}
								balanceInCents={Number(row.balance ?? 0)}
							/>
						))
					}
				</div>
			</section>

			<section class="space-y-3">
				<h2 class="text-xs font-medium uppercase tracking-[0.25em] text-neutral-500">
					Movimientos
				</h2>
				<TransactionList supabase={supabase} />
			</section>
		</div>

		<QuickExpenseModal categories={categories} client:load />
	</main>
</BaseLayout>
