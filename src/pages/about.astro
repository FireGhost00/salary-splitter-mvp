---
import BaseLayout from "../layouts/BaseLayout.astro";

// Página pública: no requiere sesión.
export const prerender = false;

const cards = [
	{
		title: "Filosofía",
		body: "Presupuesto Base Cero: a cada peso que entra se le asigna un trabajo antes de gastarlo. El reparto guía es 50 % Necesidad · 30 % Deseo · 20 % Ahorro, con la deuda y las provisiones absorbidas dentro del 50 %.",
		icon: "philosophy",
	},
	{
		title: "Privacidad",
		body: "Tus datos viven en tu cuenta y solo en tu cuenta. Toda lectura y escritura pasa por autenticación SSR segura (cookies de sesión + RLS en la base de datos): nadie más ve tus movimientos.",
		icon: "privacy",
	},
	{
		title: "Tecnología",
		body: "Impulsada por Astro para el renderizado, React para las islas interactivas y Supabase (Postgres + Auth) como backend. Rápida, ligera y sin dependencias pesadas.",
		icon: "tech",
	},
];
---

<BaseLayout title="Acerca de · SalarySplitter">
	<main class="mx-auto w-full max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
		<header class="space-y-2">
			<p class="text-xs font-semibold uppercase tracking-[0.3em] text-indigo-400">
				negomez.dev
			</p>
			<h1 class="text-2xl font-semibold tracking-tight text-slate-100 sm:text-3xl">
				Acerca de SalarySplitter
			</h1>
			<p class="max-w-2xl text-sm text-slate-400">
				Una herramienta minimalista para repartir cada ingreso con el método
				50/30/20 y darle seguimiento mes a mes.
			</p>
		</header>

		<!-- PASO 1: tarjetas del producto -->
		<section class="mt-10 grid gap-4 sm:grid-cols-3">
			{
				cards.map((card) => (
					<article class="rounded-xl border border-slate-700 bg-slate-800 p-5">
						<span class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-700 bg-slate-900 text-indigo-400">
							<svg
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								{card.icon === "philosophy" && (
									<Fragment>
										<circle cx="12" cy="12" r="9" />
										<circle cx="12" cy="12" r="4" />
										<circle cx="12" cy="12" r="0.5" fill="currentColor" />
									</Fragment>
								)}
								{card.icon === "privacy" && (
									<Fragment>
										<rect x="4" y="10" width="16" height="11" rx="2" />
										<path d="M8 10V7a4 4 0 0 1 8 0v3" />
									</Fragment>
								)}
								{card.icon === "tech" && (
									<Fragment>
										<path d="m8 8-4 4 4 4" />
										<path d="m16 8 4 4-4 4" />
										<line x1="13" y1="6" x2="11" y2="18" />
									</Fragment>
								)}
							</svg>
						</span>
						<h2 class="mt-4 text-sm font-semibold text-slate-100">
							{card.title}
						</h2>
						<p class="mt-1.5 text-xs leading-relaxed text-slate-400">
							{card.body}
						</p>
					</article>
				))
			}
		</section>

		<!-- PASO 2: sobre el desarrollador -->
		<section
			class="mt-12 rounded-xl border border-slate-700 bg-slate-800 p-6 sm:p-8"
		>
			<p class="text-xs font-medium uppercase tracking-[0.25em] text-slate-400">
				Sobre el Desarrollador
			</p>
			<h2 class="mt-2 text-xl font-semibold tracking-tight text-slate-100 sm:text-2xl">
				Nelson Gomez
			</h2>
			<p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-300">
				Desarrollador de software con pasión por construir herramientas útiles y
				eficientes: interfaces limpias, backends sólidos y cero grasa. Creo en el
				software que resuelve un problema real y se quita de en medio.
			</p>

			<!-- PASO 3: portafolio + redes sociales -->
			<div class="mt-6 flex flex-wrap gap-3">
				<a
					href="https://negomez.dev"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 rounded-lg border border-slate-700 bg-slate-900 px-4 py-2.5 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700"
				>
					<svg
						width="18"
						height="18"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<circle cx="12" cy="12" r="9"></circle>
						<path d="M3 12h18"></path>
						<path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18Z"></path>
					</svg>
					Portafolio Web
				</a>

				<a
					href="https://github.com/FireGhost00"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 rounded-lg border border-slate-700 bg-slate-900 px-4 py-2.5 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700"
				>
					<svg
						width="18"
						height="18"
						viewBox="0 0 24 24"
						fill="currentColor"
						aria-hidden="true"
					>
						<path
							d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.05-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.39 1.24-3.23-.12-.31-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.18.77.84 1.24 1.91 1.24 3.23 0 4.63-2.81 5.65-5.49 5.95.43.37.81 1.1.81 2.22 0 1.6-.01 2.9-.01 3.29 0 .32.22.7.83.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"
						></path>
					</svg>
					GitHub
				</a>

				<a
					href="https://www.linkedin.com/in/nelson-gomez-a730bb167/"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 rounded-lg border border-slate-700 bg-slate-900 px-4 py-2.5 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700"
				>
					<svg
						width="18"
						height="18"
						viewBox="0 0 24 24"
						fill="currentColor"
						aria-hidden="true"
					>
						<path
							d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z"
						></path>
					</svg>
					LinkedIn
				</a>
			</div>
		</section>
	</main>
</BaseLayout>
