---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthForm from "../components/AuthForm.jsx";
import { createSupabaseServerClient } from "../lib/supabase.js";

// Ruta on-demand: procesa el POST del formulario y setea las cookies de sesión.
export const prerender = false;

const supabase = createSupabaseServerClient(Astro);

// Si ya hay sesión, no hay nada que hacer aquí.
const {
	data: { user },
} = await supabase.auth.getUser();

if (user) {
	return Astro.redirect("/dashboard");
}

// `?error=` lo pone el middleware si falla el callback de Google.
let errorMessage: string | null = Astro.url.searchParams.get("error");
let notice: string | null = null;
let mode: "signin" | "signup" = "signin";

if (Astro.request.method === "POST") {
	const form = await Astro.request.formData();
	mode = form.get("mode") === "signup" ? "signup" : "signin";
	const email = String(form.get("email") ?? "").trim();
	const password = String(form.get("password") ?? "");

	if (!email || !password) {
		errorMessage = "Email y contraseña son obligatorios.";
	} else if (mode === "signup") {
		const { data, error } = await supabase.auth.signUp({ email, password });
		if (error) {
			errorMessage = error.message;
		} else if (data.session) {
			// Confirmación de email desactivada -> ya hay sesión.
			return Astro.redirect("/dashboard");
		} else {
			// Confirmación activada -> el usuario debe confirmar por correo.
			notice =
				"Cuenta creada. Revisa tu correo para confirmarla y luego inicia sesión.";
			mode = "signin";
		}
	} else {
		const { error } = await supabase.auth.signInWithPassword({
			email,
			password,
		});
		if (error) {
			errorMessage =
				error.message === "Invalid login credentials"
					? "Email o contraseña incorrectos."
					: error.message;
		} else {
			return Astro.redirect("/dashboard");
		}
	}
}
---

<BaseLayout title="Entrar · SalarySplitter">
	<main
		class="mx-auto flex min-h-screen w-full max-w-sm flex-col justify-center px-6 py-16"
	>
		<header class="mb-8 space-y-1">
			<h1 class="text-xl font-semibold tracking-tight">SalarySplitter</h1>
			<p class="text-sm text-neutral-500">Entra o crea tu cuenta.</p>
		</header>

		<AuthForm
			client:load
			error={errorMessage}
			notice={notice}
			initialMode={mode}
		/>
	</main>
</BaseLayout>
