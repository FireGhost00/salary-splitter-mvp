---
import BaseLayout from "../layouts/BaseLayout.astro";
import IdealMonth from "../components/IdealMonth.jsx";
import { createSupabaseServerClient } from "../lib/supabase.js";

// Ruta on-demand: requiere sesión.
export const prerender = false;

const supabase = createSupabaseServerClient(Astro);

const {
	data: { user },
} = await supabase.auth.getUser();

if (!user) {
	return Astro.redirect("/login");
}

const { data: categoryRows, error } = await supabase
	.from("categories")
	.select("name, macro_type, target_amount")
	.eq("user_id", user.id);

if (error) {
	throw new Error(`No se pudieron cargar las categorías: ${error.message}`);
}

const categories = (categoryRows ?? []).map((row) => ({
	id: row.name,
	name: row.name,
	macro_type: row.macro_type ?? "",
	target_amount: Number(row.target_amount ?? 0),
}));
---

<BaseLayout title="Mes Ideal · SalarySplitter">
	<main class="mx-auto w-full max-w-2xl px-4 py-8 sm:px-6 sm:py-12">
		<header class="mb-8 flex items-center justify-between gap-4">
			<div class="space-y-1">
				<h1 class="text-xl font-semibold tracking-tight sm:text-2xl">Mes Ideal</h1>
				<p class="text-sm text-slate-400">
					Tu meta mensual por categoría (deudas, provisiones y demás).
				</p>
			</div>
			<a
				href="/dashboard"
				class="shrink-0 rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-400 transition-colors hover:text-slate-100"
			>
				← Dashboard
			</a>
		</header>

		<IdealMonth categories={categories} client:load />
	</main>
</BaseLayout>
