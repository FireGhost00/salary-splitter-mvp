---
import BaseLayout from "../layouts/BaseLayout.astro";
import TransactionHistory from "../components/TransactionHistory.jsx";
import { createSupabaseServerClient } from "../lib/supabase.js";
import { isSubcategory, parentMasterOf } from "../lib/budget.js";

// Ruta on-demand: requiere sesión.
export const prerender = false;

const supabase = createSupabaseServerClient(Astro);

const {
	data: { user },
} = await supabase.auth.getUser();

if (!user) {
	return Astro.redirect("/login");
}

// PASO 1: primer lote (página 1, 20 items). Las siguientes páginas las pide el
// componente a /api/get-history vía .range().
const PAGE_SIZE = 20;

const { data: txRows, error: txError } = await supabase
	.from("transactions")
	.select(
		"id, group_id, category_id, description, label, amount_cents, transaction_type, created_at, effective_date, subcategory",
	)
	.eq("user_id", user.id)
	.order("created_at", { ascending: false })
	.range(0, PAGE_SIZE - 1);

if (txError) {
	throw new Error(`No se pudo cargar el historial: ${txError.message}`);
}

// "JOIN" con categories para el nombre real. En esta rama `transactions.category_id`
// normalmente YA es el nombre; el mapa resuelve el caso en que sea un UUID.
// También sirve para armar el control de reclasificar (mismo criterio que
// dashboard.astro): los 3 sobres maestros + las subcategorías del usuario.
const { data: catRows, error: catError } = await supabase
	.from("categories")
	.select("id, name, macro_type")
	.eq("user_id", user.id);

if (catError) {
	console.warn("No se pudieron cargar las categorías:", catError.message);
}

const nameById = new Map((catRows ?? []).map((c) => [String(c.id), c.name]));

const transactions = (txRows ?? []).map((tx) => ({
	id: tx.id,
	group_id: tx.group_id ?? null,
	category:
		nameById.get(String(tx.category_id)) ?? tx.category_id ?? "Sin categoría",
	// Crudo (no resuelto): lo que espera PATCH /api/reclassify-transaction.
	category_id: tx.category_id,
	subcategory: tx.subcategory ?? null,
	description: tx.description,
	label: tx.label,
	amount_cents: Number(tx.amount_cents ?? 0),
	transaction_type: tx.transaction_type,
	created_at: tx.created_at,
	effective_date: tx.effective_date,
}));

const categoriesForReclassify = (catRows ?? [])
	.filter((row) => !isSubcategory(row))
	.map((row) => ({ name: row.name, macro_type: row.macro_type ?? "estandar" }));

const subcategoriesForReclassify = (catRows ?? [])
	.filter((row) => isSubcategory(row))
	.map((row) => ({ name: row.name, parentMaster: parentMasterOf(row.macro_type) }));
---

<BaseLayout title="Historial · SalarySplitter">
	<main class="mx-auto w-full max-w-2xl px-4 py-8 pb-32 sm:px-6 sm:py-12">
		<header class="mb-8 flex items-center justify-between gap-4">
			<div class="space-y-1">
				<h1 class="text-xl font-semibold tracking-tight sm:text-2xl">Historial</h1>
				<p class="text-sm text-slate-400">
					Todos tus movimientos, del más reciente al más antiguo.
				</p>
			</div>
			<a
				href="/dashboard"
				class="shrink-0 rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-400 transition-colors hover:text-slate-100"
			>
				← Dashboard
			</a>
		</header>

		<TransactionHistory
			client:load
			transactions={transactions}
			categories={categoriesForReclassify}
			subcategories={subcategoriesForReclassify}
		/>
	</main>
</BaseLayout>
