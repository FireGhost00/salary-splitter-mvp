---
// Barra de navegación superior (Modo Oscuro). BaseLayout la oculta en las
// pantallas de acceso / alta (/login, /onboarding).
const { pathname } = Astro.url;

const links = [
	{ href: "/dashboard", label: "Dashboard" },
	{ href: "/mes-ideal", label: "Mes Ideal" },
	{ href: "/historial", label: "Historial" },
	{ href: "/resumen-anual", label: "Resumen" },
	{ href: "/configuracion", label: "Configuración" },
	{ href: "/perfil", label: "Perfil" },
	{ href: "/about", label: "Acerca de" },
];

function isActive(href: string): boolean {
	return pathname === href || pathname.startsWith(`${href}/`);
}

const idle = "text-slate-300 transition-colors hover:text-white";
const activeDesktop =
	"font-semibold text-white underline decoration-emerald-400 decoration-2 underline-offset-8";
const activeMobile = "font-semibold text-white";
---

<nav
	class="sticky top-0 z-50 border-b border-slate-800 bg-slate-900/95 backdrop-blur"
	aria-label="Navegación principal"
>
	<div
		class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
	>
		<a
			href="/dashboard"
			class="shrink-0 text-sm font-semibold tracking-tight text-slate-100"
		>
			SalarySplitter
		</a>

		{/* Enlaces en escritorio */}
		<ul class="hidden items-center text-sm md:flex md:gap-6">
			{
				links.map((link) => {
					const active = isActive(link.href);
					return (
						<li>
							<a
								href={link.href}
								aria-current={active ? "page" : undefined}
								class:list={[
									"whitespace-nowrap",
									active ? activeDesktop : idle,
								]}
							>
								{link.label}
							</a>
						</li>
					);
				})
			}
		</ul>

		{/* Botón de hamburguesa (solo móvil) */}
		<button
			id="nav-toggle"
			type="button"
			aria-label="Abrir menú"
			aria-expanded="false"
			aria-controls="nav-mobile"
			class="block text-slate-300 transition-colors hover:text-white md:hidden"
		>
			<svg
				id="nav-icon-open"
				width="24"
				height="24"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<line x1="4" y1="7" x2="20" y2="7" />
				<line x1="4" y1="12" x2="20" y2="12" />
				<line x1="4" y1="17" x2="20" y2="17" />
			</svg>
			<svg
				id="nav-icon-close"
				class="hidden"
				width="24"
				height="24"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<line x1="6" y1="6" x2="18" y2="18" />
				<line x1="18" y1="6" x2="6" y2="18" />
			</svg>
		</button>
	</div>

	{/* Menú desplegable en móvil */}
	<div id="nav-mobile" class="hidden border-t border-slate-800 bg-slate-900 md:hidden">
		<ul class="mx-auto flex max-w-5xl flex-col px-4 py-1 sm:px-6">
			{
				links.map((link) => {
					const active = isActive(link.href);
					return (
						<li>
							<a
								href={link.href}
								aria-current={active ? "page" : undefined}
								class:list={[
									"block py-2.5 text-sm",
									active ? activeMobile : idle,
								]}
							>
								{link.label}
							</a>
						</li>
					);
				})
			}
		</ul>
	</div>
</nav>

<script>
	const toggle = document.getElementById("nav-toggle");
	const panel = document.getElementById("nav-mobile");
	const iconOpen = document.getElementById("nav-icon-open");
	const iconClose = document.getElementById("nav-icon-close");

	toggle?.addEventListener("click", () => {
		// toggle("hidden") devuelve true si la clase quedó puesta (menú oculto).
		const isOpen = panel?.classList.toggle("hidden") === false;
		toggle.setAttribute("aria-expanded", String(isOpen));
		toggle.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
		iconOpen?.classList.toggle("hidden", isOpen);
		iconClose?.classList.toggle("hidden", !isOpen);
	});
</script>
