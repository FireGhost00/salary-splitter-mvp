---
import { formatCentsParts } from "../../lib/money";
import DeferredFunds from "./DeferredFunds.jsx";

interface Props {
	/** Monto en centavos (entero). Ver CONVENCIONES.md §2. */
	amountInCents: number;
	/**
	 * Ingresos reservados para el próximo mes, en centavos. NO forma parte del
	 * saldo principal: se muestra aparte.
	 */
	saldoDiferido?: number;
	/** id del usuario, para el gestor de ingresos diferidos. */
	userId?: string;
}

const { amountInCents, saldoDiferido = 0, userId } = Astro.props;
const { minusSign, currencySymbol, integer, decimal, fraction } =
	formatCentsParts(amountInCents);
const isNegative = amountInCents < 0;
---

<section class="rounded-xl border border-slate-700 bg-slate-800 p-6">
	<p
		class="mb-4 flex items-center gap-2 text-xs font-medium uppercase tracking-[0.25em] text-slate-400"
	>
		<span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
		Saldo disponible
	</p>

	<p class="flex items-baseline gap-1 font-mono tabular-nums">
		<span class="text-2xl text-slate-400">{minusSign}{currencySymbol}</span>
		<span
			class:list={[
				"text-6xl font-semibold tracking-tight",
				isNegative ? "text-rose-400" : "text-emerald-400",
			]}
		>
			{integer}
		</span>
		<span class="text-2xl text-slate-400">{decimal}{fraction}</span>
	</p>

	{
		saldoDiferido > 0 && (
			<DeferredFunds
				client:load
				saldoDiferidoInCents={saldoDiferido}
				userId={userId}
			/>
		)
	}
</section>
