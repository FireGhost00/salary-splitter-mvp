---
import { formatCentsParts } from "../../lib/money";

interface Props {
	/** Monto en centavos (entero). Ver CONVENCIONES.md §2. */
	amountInCents: number;
}

const { amountInCents } = Astro.props;
const { minusSign, currencySymbol, integer, decimal, fraction } =
	formatCentsParts(amountInCents);
---

<section
	class="rounded-xl border border-neutral-800 bg-black p-6 font-mono text-neutral-100 shadow-inner"
>
	<p
		class="mb-4 flex items-center gap-2 text-xs uppercase tracking-[0.25em] text-emerald-500/80"
	>
		<span class="inline-block h-2 w-2 animate-pulse rounded-full bg-emerald-500"></span>
		saldo_disponible
	</p>

	<p class="flex items-baseline gap-1">
		<span class="text-2xl text-neutral-500">{minusSign}{currencySymbol}</span>
		<span class="text-6xl font-semibold tracking-tight tabular-nums">{integer}</span>
		<span class="text-2xl text-neutral-500">{decimal}{fraction}</span>
	</p>

	<p class="mt-4 text-xs text-neutral-600">
		<span class="text-neutral-700">raw:</span> {amountInCents} ¢
	</p>
</section>
