---
import { formatCents } from "../../lib/money";
import DeleteTransactionButton from "./DeleteTransactionButton.jsx";

interface Props {
	/** Cliente Supabase ligado a la request (creado en el dashboard). */
	supabase: import("@supabase/supabase-js").SupabaseClient;
}

const { supabase } = Astro.props;

// US-11: filtros vía query string. El formulario GET de más abajo reenvía la
// página (onchange -> this.form.submit()), así que aquí solo leemos los params.
const params = Astro.url.searchParams;
const tipo = params.get("tipo") ?? "todos"; // todos | ingresos | gastos
const orden = params.get("orden") ?? "recientes"; // recientes | antiguos

// Antiguos => primero los más viejos.
const ascending = orden === "antiguos";

let query = supabase
	.from("transactions")
	.select("id, label, amount_cents, transaction_type, created_at", {
		count: "exact",
	});

// Ingresos guardan amount_cents > 0; gastos, amount_cents < 0 (CONVENCIONES.md §2).
if (tipo === "ingresos") {
	query = query.gt("amount_cents", 0);
} else if (tipo === "gastos") {
	query = query.lt("amount_cents", 0);
}

// US-12: paginación SSR. Lee ?page=N (1 por defecto), 10 items por página, y
// pide a Supabase el rango [from, to] en lugar de un .limit() fijo.
const PAGE_SIZE = 10;
const requestedPage = Number.parseInt(params.get("page") ?? "1", 10);
const page =
	Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1;
const from = (page - 1) * PAGE_SIZE;
const to = from + PAGE_SIZE - 1;

const { data, error, count } = await query
	.order("created_at", { ascending })
	.range(from, to);

if (error) {
	throw new Error(`No se pudo cargar transactions: ${error.message}`);
}

const transactions = data ?? [];

const totalItems = count ?? 0;
const totalPages = Math.max(1, Math.ceil(totalItems / PAGE_SIZE));
const hasPrev = page > 1;
const hasNext = page < totalPages;

// Clona los searchParams actuales (tipo, orden, …) y solo sobrescribe `page`,
// para no perder los filtros de US-11 al cambiar de página.
function pageHref(targetPage: number): string {
	const nextParams = new URLSearchParams(params);
	nextParams.set("page", String(targetPage));
	return `?${nextParams.toString()}`;
}

const dateFormatter = new Intl.DateTimeFormat("es", {
	day: "2-digit",
	month: "short",
});

const selectClass =
	"rounded-lg border border-slate-700 bg-slate-950 px-3 py-1.5 text-xs text-slate-300 focus:border-slate-500 focus:outline-none";
---

<div class="space-y-3">
	<form method="get" class="flex flex-wrap gap-2">
		<select name="tipo" onchange="this.form.submit()" class={selectClass}>
			<option value="todos" selected={tipo === "todos"}>Todos</option>
			<option value="ingresos" selected={tipo === "ingresos"}>Ingresos</option>
			<option value="gastos" selected={tipo === "gastos"}>Gastos</option>
		</select>

		<select name="orden" onchange="this.form.submit()" class={selectClass}>
			<option value="recientes" selected={orden === "recientes"}>Recientes</option>
			<option value="antiguos" selected={orden === "antiguos"}>Antiguos</option>
		</select>

		<noscript>
			<button
				type="submit"
				class="rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-300"
			>
				Aplicar
			</button>
		</noscript>
	</form>

	<div class="overflow-x-auto rounded-xl border border-slate-800">
		<table class="w-full text-sm">
			<thead>
				<tr
					class="border-b border-slate-800 text-left text-xs uppercase tracking-wider text-slate-500"
				>
					<th class="px-4 py-2 font-medium">Concepto</th>
					<th class="px-4 py-2 font-medium">Tipo</th>
					<th class="px-4 py-2 font-medium">Fecha</th>
					<th class="px-4 py-2 text-right font-medium">Monto</th>
					<th class="px-4 py-2"><span class="sr-only">Acciones</span></th>
				</tr>
			</thead>
			<tbody class="divide-y divide-slate-800">
				{
					transactions.length === 0 && (
						<tr>
							<td colspan="5" class="px-4 py-6 text-center text-slate-500">
								Sin movimientos con estos filtros.
							</td>
						</tr>
					)
				}
				{
					transactions.map((tx) => (
						<tr>
							<td class="px-4 py-2.5 text-slate-100">{tx.label}</td>
							<td class="px-4 py-2.5 text-slate-400">{tx.transaction_type}</td>
							<td class="px-4 py-2.5 text-slate-500">
								{tx.created_at
									? dateFormatter.format(new Date(tx.created_at))
									: "—"}
							</td>
							<td
								class:list={[
									"px-4 py-2.5 text-right font-mono tabular-nums",
									tx.amount_cents < 0 ? "text-rose-400" : "text-emerald-400",
								]}
							>
								{formatCents(tx.amount_cents)}
							</td>
							<td class="px-4 py-2.5 text-right">
								<DeleteTransactionButton client:visible id={tx.id} />
							</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>

	<nav
		class="flex items-center justify-between gap-2"
		aria-label="Paginación de movimientos"
	>
		{
			hasPrev ? (
				<a
					href={pageHref(page - 1)}
					rel="prev"
					class="rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-300 transition-colors hover:border-slate-500 hover:text-slate-100"
				>
					← Anterior
				</a>
			) : (
				<span
					aria-disabled="true"
					class="cursor-not-allowed rounded-lg border border-slate-800 px-3 py-1.5 text-xs text-slate-600"
				>
					← Anterior
				</span>
			)
		}

		<span class="text-xs text-slate-500">Página {page} de {totalPages}</span>

		{
			hasNext ? (
				<a
					href={pageHref(page + 1)}
					rel="next"
					class="rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-300 transition-colors hover:border-slate-500 hover:text-slate-100"
				>
					Siguiente →
				</a>
			) : (
				<span
					aria-disabled="true"
					class="cursor-not-allowed rounded-lg border border-slate-800 px-3 py-1.5 text-xs text-slate-600"
				>
					Siguiente →
				</span>
			)
		}
	</nav>
</div>

