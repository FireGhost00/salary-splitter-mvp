---
import { formatCents } from "../../lib/money";
import DeleteTransactionButton from "./DeleteTransactionButton.jsx";

interface Props {
	/** Cliente Supabase ligado a la request (creado en el dashboard). */
	supabase: import("@supabase/supabase-js").SupabaseClient;
}

const { supabase } = Astro.props;

// Últimos 7 movimientos del usuario (RLS filtra por auth.uid()).
const { data, error } = await supabase
	.from("transactions")
	.select("id, label, amount_cents, transaction_type, created_at")
	.order("created_at", { ascending: false })
	.limit(7);

if (error) {
	throw new Error(`No se pudo cargar transactions: ${error.message}`);
}

const transactions = data ?? [];

const dateFormatter = new Intl.DateTimeFormat("es", {
	day: "2-digit",
	month: "short",
});
---

<div class="overflow-x-auto rounded-xl border border-slate-800">
	<table class="w-full text-sm">
		<thead>
			<tr
				class="border-b border-slate-800 text-left text-xs uppercase tracking-wider text-slate-500"
			>
				<th class="px-4 py-2 font-medium">Concepto</th>
				<th class="px-4 py-2 font-medium">Tipo</th>
				<th class="px-4 py-2 font-medium">Fecha</th>
				<th class="px-4 py-2 text-right font-medium">Monto</th>
				<th class="px-4 py-2"><span class="sr-only">Acciones</span></th>
			</tr>
		</thead>
		<tbody class="divide-y divide-slate-800">
			{
				transactions.length === 0 && (
					<tr>
						<td colspan="5" class="px-4 py-6 text-center text-slate-500">
							Sin movimientos todavía.
						</td>
					</tr>
				)
			}
			{
				transactions.map((tx) => (
					<tr>
						<td class="px-4 py-2.5 text-slate-100">{tx.label}</td>
						<td class="px-4 py-2.5 text-slate-400">{tx.transaction_type}</td>
						<td class="px-4 py-2.5 text-slate-500">
							{tx.created_at
								? dateFormatter.format(new Date(tx.created_at))
								: "—"}
						</td>
						<td
							class:list={[
								"px-4 py-2.5 text-right font-mono tabular-nums",
								tx.amount_cents < 0 ? "text-rose-400" : "text-emerald-400",
							]}
						>
							{formatCents(tx.amount_cents)}
						</td>
						<td class="px-4 py-2.5 text-right">
							<DeleteTransactionButton client:visible id={tx.id} />
						</td>
					</tr>
				))
			}
		</tbody>
	</table>
</div>
