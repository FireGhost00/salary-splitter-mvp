# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repo.

# Servidor (SSR / endpoints).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Navegador (login con Google en AuthForm). Mismos valores que arriba;
# el prefijo PUBLIC_ es lo que permite exponerlos al cliente en Astro.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
