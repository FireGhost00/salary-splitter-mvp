# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repo.

# Servidor (SSR / endpoints).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Navegador (login con Google en AuthForm). Mismos valores que arriba;
# el prefijo PUBLIC_ es lo que permite exponerlos al cliente en Astro.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Rate limiting (src/lib/rate-limit.js) — Upstash Redis REST API. Servidor
# únicamente, nunca PUBLIC_. OPCIONALES: si faltan, el rate limiting queda
# desactivado (fail-open) en vez de romper la app; solo hacen falta antes de
# desplegar a producción. Ver README § Variables de entorno.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
